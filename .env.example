# Default: local simulation only. No fiat conversion, real charges or chain writes.
PAYMENT_MODE=simulated
CHAIN_MODE=simulated
PORT=3000
APP_ORIGIN=http://localhost:3000
DATA_DIR=./data

# Optional Razorpay TEST mode. Restart after setting these.
# PAYMENT_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional real testnet settlement. Encrypted Foundry keystores only.
# CHAIN_MODE=testnet
RPC_URL=https://rpc.testnet.whitechain.io
RELAYER_KEYSTORE=
TREASURY_KEYSTORE=
# Enter passwords privately in your terminal environment before starting.
# Never paste keys/passwords in chat or commit them.
MERCHANT_ADDRESS=0x4f961b8abd8af7ccdccc4f76cd7326d8fbea0594
