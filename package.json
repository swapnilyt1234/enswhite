{
  "name": "enswhite",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env app/server.js",
    "company": "node --env-file-if-exists=.env.company app/run-company.js",
    "demo:employees": "node --env-file-if-exists=.env.company app/demo-runtime.js",
    "test": "node --test app/*.test.js",
    "check:chain": "node --env-file-if-exists=.env app/check-chain.js",
    "ens:check": "node --env-file-if-exists=.env.ens ens/scripts/bootstrap.js check",
    "ens:test": "forge test --root ens -vv",
    "build:landing": "tailwindcss -i app/styles/landing.css -o app/judge-public/landing.css --minify",
    "build:theme": "tailwindcss -i app/styles/app-theme.css -o app/judge-public/app-theme.css --minify && node app/sync-theme.js",
    "build:ui": "npm run build:landing && npm run build:theme"
  },
  "dependencies": {
    "ethers": "^6.17.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
